{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FoodlinkUnifiedUIContracts",
  "description": "Standard schema contracts for Foodlink UI listings and orders",
  "definitions": {
    "SurplusListing": {
      "type": "object",
      "required": ["id", "merchantName", "title", "originalPrice", "discountedPrice", "quantityAvailable"],
      "properties": {
        "id": { "type": "string" },
        "merchantId": { "type": "string" },
        "merchantName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "originalPrice": { "type": "number", "minimum": 0 },
        "discountedPrice": { "type": "number", "minimum": 0 },
        "quantityAvailable": { "type": "integer", "minimum": 0 },
        "pickupStartTime": { "type": "string" },
        "pickupEndTime": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "SOLD_OUT", "EXPIRED"] }
      }
    },
    "FoodlinkOrder": {
      "type": "object",
      "required": ["id", "orderNumber", "listingId", "quantity", "totalPrice", "pickupCode", "status"],
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "listingId": { "type": "string" },
        "merchantName": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "totalPrice": { "type": "number", "minimum": 0 },
        "pickupCode": { "type": "string" },
        "status": { "type": "string", "enum": ["RESERVED", "READY_FOR_PICKUP", "COMPLETED", "CANCELLED"] }
      }
    }
  }
}

